# Copy to .env (never commit .env). Values here are local-development placeholders only.

# --- API ---
NODE_ENV=development
API_PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Database (docker compose) ---
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/couple_finance
# Optional direct (non-pooled) connection for migrations; Neon on Vercel injects it automatically.
# DATABASE_URL_UNPOOLED=
# Connections per API instance (use 3–5 on Vercel; Neon's pooler multiplexes them)
DATABASE_POOL_MAX=10
# Used by the API e2e test suite (database created by infra/postgres/init)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/couple_finance_test

# --- Auth (ADR-004) ---
# HS256 signing key for access tokens, >= 32 chars. Generate one outside local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The API refuses to start in production while this still contains "change-me".
JWT_ACCESS_SECRET=change-me-local-only-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_EMAIL=10
# Requests per minute per signed-in user (or IP) on all other endpoints
API_RATE_LIMIT_PER_MINUTE=300

# --- Deployment (docs/implementation/DEPLOYMENT.md) ---
# Express trust proxy: false locally; true on Vercel (it overwrites X-Forwarded-For)
TRUST_PROXY=false
# Optional shared rate-limit counters (Upstash Redis REST). On Vercel the Upstash integration
# injects KV_REST_API_URL / KV_REST_API_TOKEN, which are used when these are unset.
# RATE_LIMIT_REDIS_REST_URL=
# RATE_LIMIT_REDIS_REST_TOKEN=
# Build-time only (Vercel): run migrations during `vercel-build` for this environment
# RUN_MIGRATIONS_ON_BUILD=false

